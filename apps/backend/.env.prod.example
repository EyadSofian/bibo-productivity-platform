# PRODUCTION backend config. Copy to .env (or let scripts/start-env.sh export these).
# Separate Postgres database from dev/staging — never shares state.
#
# Local run: scripts/dev-db.sh creates the `ctracking_prod` database for you.
# Real production (bibotracker.com) overrides DATABASE_URL/JWT_SECRET via its own .env.

# HTTP port (distinct from dev :8080 / staging :8081 so envs can run side by side locally).
PORT=8082

# Postgres — production database.
DATABASE_URL=postgres://ctracking:ctracking@localhost:5432/ctracking_prod?sslmode=disable

# Secret used to sign JWT access/refresh tokens. MUST be a long random value in real prod.
JWT_SECRET=prod-change-me-to-a-long-random-secret

# Root directory for on-disk screenshot storage (no S3). Per-env so blobs don't mix.
STORAGE_DIR=./storage-prod

# Origin allowed by CORS (the web-admin dev server).
WEB_ADMIN_ORIGIN=http://localhost:5174

# Sentry — production error reporting (backend project).
APP_ENV=production
SENTRY_DSN=https://b1ef6d637f6c430cb96e06b36af35296@o714773.ingest.us.sentry.io/5779545

# See .env.example for TRUSTED_PROXIES / TRUSTED_PLATFORM.
# This deployment sits behind Cloudflare, so identify the real client IP:
TRUSTED_PLATFORM=CF-Connecting-IP
TRUSTED_PROXIES=

# The retired still-screenshot pipeline (docs/adr/0002-video-first-media-plane.md).
# Screen monitoring is video; still images are no longer a monitoring artifact, so
# this is FALSE and omitted everywhere. It exists only so an operator can accept
# uploads for one migration deploy while agents roll forward. Anything unset,
# empty or unparseable means disabled, and the video-first CI guard fails the
# build if it is ever committed as enabled. Removed outright in slice V12.
# LEGACY_STILL_CAPTURE_ENABLED=false
\n
# Video media plane (docs/adr/0002-video-first-media-plane.md). The control plane
# is live; no SFU is wired up yet (slice V05), so leaving MEDIA_PROVIDER empty
# selects the "unconfigured" provider, which fails every media operation with
# MEDIA_PROVIDER_UNCONFIGURED rather than pretending to work.
MEDIA_PROVIDER=

# Lifetime of a minted media token, in seconds. Short by design: a leaked token
# is only useful for this long, and clients re-authorize through the API for
# another. Clamped to 30..900; anything outside that falls back to 120.
MEDIA_TOKEN_TTL_SECONDS=120
