# DEV / LOCAL backend config. Copy to .env for local dev.
# One of three per-environment configs (see .env.staging.example / .env.prod.example);
# each env uses a SEPARATE Postgres database so dev/staging/prod never share state.

# HTTP port the backend listens on (staging uses :8081, production :8082 locally).
# MUST stay 8090 for local dev: scripts/dev-backend.sh, the web-admin Vite proxy
# (apps/web-admin/vite.config.ts) and the desktop's local default all target :8090.
PORT=8090

# Postgres connection string.
DATABASE_URL=postgres://ctracking:ctracking@localhost:5432/ctracking?sslmode=disable

# Secret used to sign JWT access/refresh tokens. The backend refuses to start if this
# is unset. In staging/production use at least 32 random bytes and never the dev value
# below — anyone holding it can mint tokens for any account:
#   openssl rand -base64 48
JWT_SECRET=dev-only-change-me

# Root directory for on-disk screenshot storage (no S3).
STORAGE_DIR=./storage

# Origin allowed by CORS (the web-admin dev server).
WEB_ADMIN_ORIGIN=http://localhost:5174

# Deploy environment label sent to Sentry (local/staging/production).
APP_ENV=local

# Sentry DSN for backend error reporting. Leave EMPTY to disable (recommended for
# local dev). Production uses the backend project DSN.
SENTRY_DSN=

# Secret token for the CPU keep-alive endpoint (POST /v1/keepalive). Leave EMPTY to
# DISABLE the route entirely (recommended for local/staging). Set a long random value
# in production to keep the Oracle Always Free box above the idle-reclamation threshold.
KEEPALIVE_TOKEN=

# Proxies whose X-Forwarded-For may be believed, comma-separated (IPs or CIDRs).
# EMPTY = trust nobody, which is the safe default: without this the client itself
# chooses the IP used for rate limiting, and a rotating header defeats the login
# throttle entirely. Local dev talks to the backend directly, so leave it empty.
TRUSTED_PROXIES=

# Alternative for a deployment behind a single trusted edge: the header carrying
# the real client IP (e.g. CF-Connecting-IP behind Cloudflare). Takes precedence
# over TRUSTED_PROXIES. Only safe when the edge is the ONLY route to this backend.
TRUSTED_PLATFORM=

# The retired still-screenshot pipeline (docs/adr/0002-video-first-media-plane.md).
# Screen monitoring is video; still images are no longer a monitoring artifact, so
# this is FALSE and omitted everywhere. It exists only so an operator can accept
# uploads for one migration deploy while agents roll forward. Anything unset,
# empty or unparseable means disabled, and the video-first CI guard fails the
# build if it is ever committed as enabled. Removed outright in slice V12.
# LEGACY_STILL_CAPTURE_ENABLED=false

# Video media plane (docs/adr/0002-video-first-media-plane.md). The control plane
# supports LiveKit. Set MEDIA_PROVIDER=livekit and all three LIVEKIT_* values
# below. Empty or incomplete configuration disables video with the explicit
# MEDIA_PROVIDER_UNCONFIGURED response.
MEDIA_PROVIDER=

# Lifetime of a minted media token, in seconds. Short by design: a leaked token
# is only useful for this long, and clients re-authorize through the API for
# another. Clamped to 30..900; anything outside that falls back to 120.
MEDIA_TOKEN_TTL_SECONDS=120

# Video service (server-side credentials only).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
