{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BiBoTracking",
  "version": "1.5.9",
  "identifier": "com.briannguyen.bibotracking",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BiBoTracking",
        "width": 1040,
        "height": 720,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "acceptFirstMouse": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/screenshots/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzQTI3MUNERThERDM2MTYKUldRV050M296WEdpWStqdm5zK25zd1QvaldjMDJVMmx2YnJ2cFVHRzgzaTlVTnN1ay95UHFEYXMK",
      "endpoints": ["https://web-production-25e92.up.railway.app/download/latest.json"],
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "BiBoTracking",
    "category": "Productivity",
    "shortDescription": "Transparent employee time and activity tracking",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "wix": {
        "upgradeCode": "635fe27b-2dc2-59e0-8f23-ea5df009ea99"
      },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "BiBoTracking"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "Developer ID Application: Nguyen Giang Nam (MVT95X368D)"
    }
  }
}
